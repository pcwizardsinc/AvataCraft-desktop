+        const double sec = static_cast<double>(frame) / (fps > 0.0 ? fps : 30.0);
+        const int s = static_cast<int>(sec);
+        char buf[32];
+        std::snprintf(buf, sizeof buf, "%02d:%02d:%02d.%02d", s / 3600, (s / 60) % 60, s % 60,
