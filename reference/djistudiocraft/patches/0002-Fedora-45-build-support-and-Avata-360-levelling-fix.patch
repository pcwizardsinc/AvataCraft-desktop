+        std::size_t start = 0;
+        while (start < out.size()) {
+            std::size_t end = out.find('\n', start);
+            if (end == std::string::npos) {
+                end = out.size();
+            }
+            std::string line = out.substr(start, end - start);
+            if (!line.empty() && line.back() == '\r') {
+                line.pop_back();
+            }
+            if (!line.empty()) {
+                lines.push_back(std::move(line));
+            }
+            start = end + 1;
