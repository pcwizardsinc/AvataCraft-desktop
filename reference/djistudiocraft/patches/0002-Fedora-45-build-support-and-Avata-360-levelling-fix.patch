From 27975460b9a87bfcaa1358dbac3543aa85c4c9ce Mon Sep 17 00:00:00 2001
From: Andrew Chadick <andrew@chadick.org>
Date: Mon, 9 Nov 2026 13:03:48 -0800
Subject: [PATCH 2/7] Fedora 45 build support and Avata 360 levelling fix

---
 CMakeLists.txt                                |  37 ++++
 cmake/OsvFFmpeg.cmake                         |  24 ++-
 cmake/OsvImGui.cmake                          |  62 ++++++
 .../linux/io.github.kemerd.OpenOSV.desktop    |  11 ++
 src/osv/geom/AttitudeTrack.cpp                |  76 ++++++-
 tests/unit/test_video.cpp                     |  56 ++++--
 tools/osvgui/Platform.cpp                     | 185 +++++++++++++++++-
 tools/osvgui/Platform.h                       |   3 +-
 8 files changed, 424 insertions(+), 30 deletions(-)
 create mode 100644 cmake/OsvImGui.cmake
 create mode 100644 packaging/linux/io.github.kemerd.OpenOSV.desktop

diff --git a/CMakeLists.txt b/CMakeLists.txt
index c27a245..85fe9d8 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -100,7 +100,21 @@ find_package(fmt CONFIG REQUIRED)
 find_package(spdlog CONFIG REQUIRED)
 find_package(nlohmann_json CONFIG REQUIRED)
 find_package(CLI11 CONFIG REQUIRED)
+# tinyexr: vcpkg exports unofficial::tinyexr::tinyexr; the Fedora
+# (tinyexr-devel) and Debian/Ubuntu (libtinyexr-dev) packages export the
+# upstream tinyexr::tinyexr (or a bare tinyexr) instead.  Normalise them all
+# to the vcpkg name the module CMakeLists.txt files link against.
 find_package(tinyexr CONFIG REQUIRED)
+if(NOT TARGET unofficial::tinyexr::tinyexr)
+  add_library(unofficial::tinyexr::tinyexr INTERFACE IMPORTED)
+  if(TARGET tinyexr::tinyexr)
+    target_link_libraries(unofficial::tinyexr::tinyexr INTERFACE tinyexr::tinyexr)
+  elseif(TARGET tinyexr)
+    target_link_libraries(unofficial::tinyexr::tinyexr INTERFACE tinyexr)
+  else()
+    message(FATAL_ERROR "tinyexr was found but exports no known target (install tinyexr-devel)")
+  endif()
+endif()
 
 # OpenOSV Studio (tools/osvgui), the desktop app in front of osvtool, draws
 # with Dear ImGui on GLFW + OpenGL 3.  vcpkg.json asks for both on Windows
@@ -110,6 +124,13 @@ find_package(tinyexr CONFIG REQUIRED)
 find_package(imgui CONFIG QUIET)
 find_package(glfw3 CONFIG QUIET)
 find_package(OpenGL QUIET)
+# Linux: glfw-devel and the GL headers come from the distribution, Dear ImGui
+# (with its GLFW + OpenGL 3 backends) is built from source (cmake/OsvImGui.cmake).
+option(OSV_FETCH_IMGUI "Linux: build Dear ImGui from source when no imgui package is found" ON)
+if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND OSV_FETCH_IMGUI AND NOT TARGET imgui::imgui
+   AND TARGET glfw AND TARGET OpenGL::GL)
+  include(OsvImGui)
+endif()
 if(TARGET imgui::imgui AND TARGET glfw AND TARGET OpenGL::GL)
   set(_osv_gui_available ON)
 else()
@@ -171,6 +192,22 @@ if(OSV_BUILD_OFX)
   endif()
 endif()
 
+# -----------------------------------------------------------------------------
+#  Install (Linux: `cmake --install build`, or an RPM %install section)
+# -----------------------------------------------------------------------------
+if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
+  include(GNUInstallDirs)
+  if(TARGET osvtool)
+    install(TARGETS osvtool RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
+  endif()
+  if(TARGET osvgui)
+    install(TARGETS osvgui RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
+    install(FILES packaging/linux/io.github.kemerd.OpenOSV.desktop
+            DESTINATION ${CMAKE_INSTALL_DATADIR}/applications)
+  endif()
+  install(FILES LICENSE NOTICE DESTINATION ${CMAKE_INSTALL_DOCDIR})
+endif()
+
 # -----------------------------------------------------------------------------
 #  Summary
 # -----------------------------------------------------------------------------
diff --git a/cmake/OsvFFmpeg.cmake b/cmake/OsvFFmpeg.cmake
index c0dd5cb..c35fe62 100644
--- a/cmake/OsvFFmpeg.cmake
+++ b/cmake/OsvFFmpeg.cmake
@@ -24,12 +24,24 @@ endforeach()
 
 # vcpkg ships a FindFFMPEG.cmake wrapper that fills FFMPEG_INCLUDE_DIRS,
 # FFMPEG_LIBRARIES and FFMPEG_LIBRARY_DIRS for the enabled components.
-find_package(FFMPEG REQUIRED)
-
-add_library(osv_ffmpeg INTERFACE)
-target_include_directories(osv_ffmpeg INTERFACE ${FFMPEG_INCLUDE_DIRS})
-target_link_directories(osv_ffmpeg INTERFACE ${FFMPEG_LIBRARY_DIRS})
-target_link_libraries(osv_ffmpeg INTERFACE ${FFMPEG_LIBRARIES})
+#
+# Linux (Fedora and friends) builds against the distribution's FFmpeg instead
+# of vcpkg's.  There is no FindFFMPEG.cmake there, so fall back to pkg-config,
+# which every distro FFmpeg -devel package ships .pc files for.
+if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND NOT DEFINED VCPKG_TOOLCHAIN)
+  find_package(PkgConfig REQUIRED)
+  pkg_check_modules(OSV_LIBAV REQUIRED IMPORTED_TARGET
+    libavcodec libavformat libavutil libswscale libswresample)
+  add_library(osv_ffmpeg INTERFACE)
+  target_link_libraries(osv_ffmpeg INTERFACE PkgConfig::OSV_LIBAV)
+  set(FFMPEG_INCLUDE_DIRS ${OSV_LIBAV_INCLUDE_DIRS})
+else()
+  find_package(FFMPEG REQUIRED)
+  add_library(osv_ffmpeg INTERFACE)
+  target_include_directories(osv_ffmpeg INTERFACE ${FFMPEG_INCLUDE_DIRS})
+  target_link_directories(osv_ffmpeg INTERFACE ${FFMPEG_LIBRARY_DIRS})
+  target_link_libraries(osv_ffmpeg INTERFACE ${FFMPEG_LIBRARIES})
+endif()
 
 # FFmpeg's public headers are C; make sure C++ consumers see the correct
 # declarations of the stdint macros they rely on.
diff --git a/cmake/OsvImGui.cmake b/cmake/OsvImGui.cmake
new file mode 100644
index 0000000..ecd1506
--- /dev/null
+++ b/cmake/OsvImGui.cmake
@@ -0,0 +1,62 @@
+# =============================================================================
+#  OsvImGui.cmake
+#
+#  Dear ImGui for OpenOSV Studio (tools/osvgui) on systems without vcpkg.
+#
+#  vcpkg builds imgui with its GLFW + OpenGL 3 backends and exports
+#  imgui::imgui.  Linux distributions either do not package Dear ImGui or
+#  package it without those backends, so on Linux the same release vcpkg pins
+#  (v1.92.9b) is compiled here, from one of:
+#
+#    OSV_IMGUI_SOURCE_DIR  an unpacked imgui-1.92.9b tree (offline / RPM
+#                          builds: ship the tarball as a second Source and
+#                          point this at it)
+#    otherwise             the release tarball, downloaded at configure time
+#                          and checked against its SHA-256.
+#
+#  Result: the static target imgui::imgui with the include layout the app's
+#  sources expect (<imgui.h>, <imgui_impl_glfw.h>, <imgui_impl_opengl3.h>,
+#  <imgui_stdlib.h>).
+# =============================================================================
+if(TARGET imgui::imgui)
+  return()
+endif()
+
+set(OSV_IMGUI_VERSION "1.92.9b")
+set(OSV_IMGUI_SHA256 "21d8a0a565e85dce943e375db00812c2f3f0ab21f3f0f7964e364a63422d7f99")
+set(OSV_IMGUI_SOURCE_DIR "" CACHE PATH "Unpacked Dear ImGui ${OSV_IMGUI_VERSION} source tree (skips the download)")
+
+if(OSV_IMGUI_SOURCE_DIR)
+  set(_imgui_dir "${OSV_IMGUI_SOURCE_DIR}")
+else()
+  include(FetchContent)
+  FetchContent_Declare(osv_imgui
+    URL "https://github.com/ocornut/imgui/archive/refs/tags/v${OSV_IMGUI_VERSION}.tar.gz"
+    URL_HASH "SHA256=${OSV_IMGUI_SHA256}"
+    DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
+  FetchContent_MakeAvailable(osv_imgui)
+  set(_imgui_dir "${osv_imgui_SOURCE_DIR}")
+endif()
+
+if(NOT EXISTS "${_imgui_dir}/imgui.cpp" OR NOT EXISTS "${_imgui_dir}/backends/imgui_impl_glfw.cpp")
+  message(FATAL_ERROR "Dear ImGui sources not found in '${_imgui_dir}'")
+endif()
+
+add_library(osv_imgui STATIC
+  "${_imgui_dir}/imgui.cpp"
+  "${_imgui_dir}/imgui_draw.cpp"
+  "${_imgui_dir}/imgui_tables.cpp"
+  "${_imgui_dir}/imgui_widgets.cpp"
+  "${_imgui_dir}/imgui_demo.cpp"
+  "${_imgui_dir}/backends/imgui_impl_glfw.cpp"
+  "${_imgui_dir}/backends/imgui_impl_opengl3.cpp"
+  "${_imgui_dir}/misc/cpp/imgui_stdlib.cpp")
+target_include_directories(osv_imgui SYSTEM PUBLIC
+  "${_imgui_dir}"
+  "${_imgui_dir}/backends"
+  "${_imgui_dir}/misc/cpp")
+target_link_libraries(osv_imgui PUBLIC glfw OpenGL::GL ${CMAKE_DL_LIBS})
+set_target_properties(osv_imgui PROPERTIES FOLDER "third_party" POSITION_INDEPENDENT_CODE ON)
+add_library(imgui::imgui ALIAS osv_imgui)
+
+message(STATUS "Dear ImGui     : ${OSV_IMGUI_VERSION} built from ${_imgui_dir}")
